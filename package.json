{
  "name": "dravyaguna-world",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "data:validate": "node scripts/validate-data.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm data:validate && pnpm evidence:validate && pnpm format:check && pnpm build",
    "evidence:validate": "node scripts/validate-evidence.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
