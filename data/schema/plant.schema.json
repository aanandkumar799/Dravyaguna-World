{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://dravyaguna-world.example/schema/plant.schema.json",
  "title":"Dravyaguna World Plant",
  "type":"object",
  "additionalProperties":false,
  "required":["id","slug","identity","names","taxonomy","status"],
  "properties":{
    "id":{"type":"string","pattern":"^plant-[a-z0-9-]+$"},
    "slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "identity":{
      "type":"object","additionalProperties":false,"required":["botanicalName"],
      "properties":{
        "botanicalName":{"type":"string","minLength":2},
        "authority":{"type":"string"},
        "acceptedNameStatus":{"enum":["accepted","synonym","review","unverified"]}
      }
    },
    "names":{
      "type":"object","additionalProperties":false,
      "properties":{
        "sanskrit":{"type":"array","items":{"type":"string"}},
        "common":{"type":"array","items":{"type":"string"}},
        "regional":{"type":"array","items":{"type":"string"}},
        "synonyms":{"type":"array","items":{"type":"string"}}
      }
    },
    "taxonomy":{
      "type":"object","additionalProperties":false,
      "properties":{
        "kingdom":{"type":"string"},"family":{"type":"string"},"genus":{"type":"string"},"species":{"type":"string"}
      }
    },
    "status":{"enum":["draft","review","verified","deprecated"]},
    "parts":{"type":"array","items":{"type":"string","enum":["whole-plant","root","stem","bark","leaf","flower","fruit","seed","rhizome","bulb","tuber","latex","resin","other"]}},
    "study":{
      "type":"object","additionalProperties":false,
      "properties":{
        "habit":{"type":"string"},
        "morphology":{"type":"string"},
        "habitat":{"type":"string"},
        "distribution":{"type":"string"},
        "identificationFeatures":{"type":"array","items":{"type":"string"}},
        "usefulParts":{"type":"array","items":{"type":"string"}},
        "rasa":{"type":"array","items":{"type":"string"}},
        "guna":{"type":"array","items":{"type":"string"}},
        "virya":{"type":"string"},
        "vipaka":{"type":"string"},
        "karma":{"type":"array","items":{"type":"string"}},
        "dosha":{"type":"array","items":{"type":"string"}}
      }
    },
    "sources":{
      "type":"array","items":{"type":"object","additionalProperties":false,"required":["id","title","type"],
      "properties":{"id":{"type":"string"},"title":{"type":"string"},"type":{"enum":["classical","modern","taxonomic","image","other"]},"author":{"type":"string"},"year":{"type":"integer"},"locator":{"type":"string"},"url":{"type":"string"},"verification":{"enum":["unverified","reviewed","verified"]}}}
    },
    "images":{
      "type":"array","items":{"type":"object","additionalProperties":false,"required":["id","part","alt","verification"],
      "properties":{"id":{"type":"string"},"part":{"type":"string","enum":["whole-plant","root","stem","bark","leaf","flower","fruit","seed","rhizome","bulb","tuber","latex","resin","other"]},"url":{"type":"string"},"alt":{"type":"string","minLength":5},"sourceId":{"type":"string"},"license":{"type":"string"},"verification":{"enum":["unverified","reviewed","verified","rejected"]}}}
    }
  }
}